{
  "type": "object",
  "properties": {
    "thesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120,
      "uniqueItems": true
    },
    "decision_basis": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "changes_since_previous": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "falsifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "next_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "change_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "partial",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "judgment_report": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:mara:judgment-report:1.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "title",
        "as_of",
        "portfolio_context",
        "market_context",
        "decision_method",
        "conclusion",
        "evidence_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "mara.judgment-report/1.0"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "portfolio_context": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "market_context": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "decision_method": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "conclusion": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 120,
          "uniqueItems": true
        }
      }
    },
    "evidence_requests": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "need",
          "gap_type",
          "acceptance",
          "decision_impact"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "gap_type": {
            "type": "string",
            "enum": [
              "access",
              "extraction",
              "analysis"
            ]
          },
          "acceptance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "decision_impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:mara:evidence-request:1.0.0"
      }
    },
    "evidence_assessments": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "status",
          "reason",
          "fact_ids"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "incorporated",
              "still_missing",
              "not_relevant"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "fact_ids": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    }
  },
  "required": [
    "thesis",
    "weights",
    "evidence_ids",
    "decision_basis",
    "changes_since_previous",
    "assumptions",
    "risks",
    "falsifiers",
    "next_checks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:agent-perspective:1.0.0"
}
