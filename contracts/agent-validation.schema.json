{
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "qualitative_pass": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "findings": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "personal_context",
              "constraint",
              "market_evidence",
              "capability",
              "execution",
              "uncertainty"
            ]
          },
          "blocks_proposal": {
            "type": "boolean"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "resolution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "owner": {
            "type": "string",
            "enum": [
              "user",
              "context",
              "evidence",
              "buffett",
              "marks",
              "bogle",
              "validation",
              "leader",
              "developer"
            ]
          }
        },
        "required": [
          "category",
          "blocks_proposal",
          "subject",
          "reason",
          "resolution",
          "owner"
        ],
        "additionalProperties": false
      }
    },
    "change_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "partial",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "judgment_report": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:mara:judgment-report:1.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "title",
        "as_of",
        "portfolio_context",
        "market_context",
        "decision_method",
        "conclusion",
        "evidence_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "mara.judgment-report/1.0"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "portfolio_context": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "market_context": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "decision_method": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "conclusion": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 120,
          "uniqueItems": true
        }
      }
    },
    "question_reviews": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "status": {
            "enum": [
              "supported",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "fact_ids": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string"
            }
          },
          "calculation_paths": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "question_id",
          "status",
          "reason",
          "fact_ids",
          "calculation_paths",
          "next_action"
        ]
      }
    },
    "evidence_requests": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "need",
          "gap_type",
          "acceptance",
          "decision_impact"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "gap_type": {
            "type": "string",
            "enum": [
              "access",
              "extraction",
              "analysis"
            ]
          },
          "acceptance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "decision_impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:mara:evidence-request:1.0.0"
      }
    },
    "evidence_assessments": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "status",
          "reason",
          "fact_ids"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "incorporated",
              "still_missing",
              "not_relevant"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "fact_ids": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    }
  },
  "required": [
    "issues",
    "unsupported_claims",
    "qualitative_pass",
    "reason"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:agent-validation:1.0.0"
}
