{
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "qualitative_pass": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "findings": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "personal_context",
              "constraint",
              "market_evidence",
              "capability",
              "execution",
              "uncertainty"
            ]
          },
          "blocks_proposal": {
            "type": "boolean"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "resolution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "owner": {
            "type": "string",
            "enum": [
              "user",
              "context",
              "evidence",
              "buffett",
              "marks",
              "bogle",
              "validation",
              "leader",
              "developer"
            ]
          }
        },
        "required": [
          "category",
          "blocks_proposal",
          "subject",
          "reason",
          "resolution",
          "owner"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "issues",
    "unsupported_claims",
    "qualitative_pass",
    "reason"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:agent-validation:1.0.0"
}
