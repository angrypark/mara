{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mara.reader-brief/1.0"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "enum": [
        "available",
        "partial"
      ]
    },
    "headline": {
      "type": "string",
      "description": "현재 시장 상황 구역의 제목. 최근 3개월 시장의 핵심 변화를 설명해요. 개인 자금 배분이나 검토 결과의 제목이 아니에요.",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "description": "현재 시장 상황 구역의 2~4문장 요약. themes의 근거에 연결된 시장 변화·원인·상충하는 흐름을 설명해요. 개인 납입 계획·최종 배분·보류·내부 검토 결과는 key_reasons와 포트폴리오 구역에서 다뤄요.",
      "minLength": 1,
      "maxLength": 500
    },
    "themes": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "description": "이 시장 주제에서 무엇이 달라졌는지 한 줄로 설명해요.",
            "minLength": 1,
            "maxLength": 160
          },
          "what_happened": {
            "type": "string",
            "minLength": 1,
            "maxLength": 360
          },
          "portfolio_meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "counterpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 360
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 20,
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "what_happened",
          "portfolio_meaning",
          "counterpoint",
          "fact_ids"
        ],
        "additionalProperties": false
      }
    },
    "key_reasons": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string",
            "description": "최종 결정에 영향을 준 실질적인 이유를 한 줄로 설명해요. 원 주장에 있는 위험·비용·현금 필요·자료 공백 등을 드러내고 역할 이름이나 검증 절차를 제목으로 삼지 않아요.",
            "minLength": 1,
            "maxLength": 160
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 20,
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "headline",
          "explanation",
          "claim_ids"
        ],
        "additionalProperties": false
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "maxItems": 8
    }
  },
  "required": [
    "schema_version",
    "as_of",
    "period",
    "coverage",
    "headline",
    "summary",
    "themes",
    "key_reasons",
    "missing_evidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:reader-brief:1.0"
}
