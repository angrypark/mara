{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "mara.evaluation/1.0.0",
        "mara.evaluation/2.0.0"
      ]
    },
    "completed_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at": {
      "type": "string",
      "minLength": 1
    },
    "rubric": {
      "type": "object",
      "required": [
        "version",
        "criteria",
        "scale",
        "applicability"
      ]
    },
    "rubric_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_id": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:mara:agent-evaluator:1.0.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "criteria",
        "red_flags"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "red_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "maxItems": 20
        },
        "criteria": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "score",
              "reason",
              "evidence_paths",
              "missing",
              "improvements"
            ],
            "properties": {
              "id": {
                "enum": [
                  "suitability",
                  "evidence",
                  "selection",
                  "allocation",
                  "risk",
                  "implementation",
                  "monitoring",
                  "traceability"
                ]
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "evidence_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "maxItems": 20
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "maxItems": 20
              },
              "improvements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "maxItems": 20
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "status": {
                      "enum": [
                        "met",
                        "partial",
                        "missing",
                        "contradicted"
                      ]
                    },
                    "evidence_paths": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "maxItems": 6,
                      "minItems": 0
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 650
                    },
                    "counterevidence": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 650
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "evidence_paths",
                    "observation",
                    "counterevidence"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 4,
                "minItems": 4
              }
            }
          }
        },
        "change_response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "accepted",
                "partial",
                "rejected"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "G1",
                  "G2",
                  "G3",
                  "G4",
                  "G5"
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown"
                ]
              },
              "evidence_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "maxItems": 6,
                "minItems": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 650
              }
            },
            "required": [
              "id",
              "status",
              "evidence_paths",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 5,
          "minItems": 5
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "context.cashflow",
                  "context.household",
                  "market.macro",
                  "market.institutional",
                  "selection.product",
                  "selection.lookthrough",
                  "selection.quality_price",
                  "allocation.alternatives",
                  "risk.quantitative",
                  "risk.fx_household",
                  "implementation.costs",
                  "monitoring.falsifiers"
                ]
              },
              "status": {
                "enum": [
                  "supported",
                  "partial",
                  "unsupported"
                ]
              },
              "evidence_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "maxItems": 6,
                "minItems": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 450
              }
            },
            "required": [
              "id",
              "status",
              "evidence_paths",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 12,
          "minItems": 12
        },
        "judgment_report": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:mara:judgment-report:1.0",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "title",
            "as_of",
            "portfolio_context",
            "market_context",
            "decision_method",
            "conclusion",
            "evidence_ids"
          ],
          "properties": {
            "schema_version": {
              "const": "mara.judgment-report/1.0"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "as_of": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "portfolio_context": {
              "type": "string",
              "minLength": 250,
              "maxLength": 3500
            },
            "market_context": {
              "type": "string",
              "minLength": 250,
              "maxLength": 3500
            },
            "decision_method": {
              "type": "string",
              "minLength": 250,
              "maxLength": 3500
            },
            "conclusion": {
              "type": "string",
              "minLength": 250,
              "maxLength": 3500
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 120,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "score": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximum": {
          "const": 100
        },
        "band": {
          "enum": [
            "strong",
            "needs_improvement",
            "major_gaps"
          ]
        },
        "proposal_blocked": {
          "type": "boolean"
        },
        "critical_findings": {
          "type": "integer",
          "minimum": 0
        },
        "assessment": {
          "enum": [
            "critical_review",
            "quality_review"
          ]
        },
        "scored_weight": {
          "const": 100
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "strict_pass": {
          "type": "boolean"
        },
        "criterion_levels": {
          "type": "object"
        },
        "gates": {
          "type": "object"
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "deterministic_findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 50,
          "minItems": 0
        }
      },
      "required": [
        "total",
        "maximum",
        "band",
        "proposal_blocked",
        "critical_findings",
        "assessment",
        "scored_weight",
        "rule"
      ],
      "additionalProperties": false
    },
    "independence": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "completed_id",
    "run_id",
    "as_of",
    "evaluated_at",
    "rubric",
    "rubric_hash",
    "output_id",
    "output",
    "score",
    "independence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:evaluation:1.0.0"
}
