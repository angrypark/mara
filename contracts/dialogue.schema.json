{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mara.dialogue/1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "role": {
            "enum": [
              "user",
              "assistant",
              "status"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "completed",
              "failed",
              "interrupted"
            ]
          },
          "created_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "text": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "maxItems": 120
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "maxItems": 120
          },
          "next_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "maxItems": 120
          },
          "proposed_change": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "summary",
                  "reason"
                ],
                "properties": {
                  "scope": {
                    "enum": [
                      "reasoning",
                      "settings",
                      "none"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3000
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "request_id",
          "role",
          "status",
          "created_at",
          "text",
          "evidence_ids",
          "uncertainties",
          "next_questions"
        ],
        "additionalProperties": false
      }
    },
    "pending": {
      "type": "boolean"
    },
    "context_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_id",
    "messages",
    "pending",
    "context_policy"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:dialogue:1.0.0"
}
