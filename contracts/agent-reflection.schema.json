{
  "type": "object",
  "properties": {
    "investment_outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "process_evaluation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "perspective_review": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "guide_change_proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "change_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "partial",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "judgment_report": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:mara:judgment-report:1.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "title",
        "as_of",
        "portfolio_context",
        "market_context",
        "decision_method",
        "conclusion",
        "evidence_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "mara.judgment-report/1.0"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "portfolio_context": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "market_context": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "decision_method": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "conclusion": {
          "type": "string",
          "minLength": 250,
          "maxLength": 3500
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 120,
          "uniqueItems": true
        }
      }
    }
  },
  "required": [
    "investment_outcome",
    "process_evaluation",
    "perspective_review",
    "lessons",
    "guide_change_proposals"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:agent-reflection:1.0.0"
}
