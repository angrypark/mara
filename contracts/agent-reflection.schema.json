{
  "type": "object",
  "properties": {
    "investment_outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "process_evaluation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "perspective_review": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "guide_change_proposals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "maxItems": 120
    },
    "change_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "partial",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  },
  "required": [
    "investment_outcome",
    "process_evaluation",
    "perspective_review",
    "lessons",
    "guide_change_proposals"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:agent-reflection:1.0.0"
}
