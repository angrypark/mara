{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:agent-evaluator:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "criteria",
    "red_flags"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "maxItems": 20
    },
    "criteria": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "reason",
          "evidence_paths",
          "missing",
          "improvements"
        ],
        "properties": {
          "id": {
            "enum": [
              "suitability",
              "evidence",
              "selection",
              "allocation",
              "risk",
              "implementation",
              "monitoring",
              "traceability"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 20
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 20
          },
          "improvements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 20
          }
        }
      }
    },
    "change_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "partial",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
