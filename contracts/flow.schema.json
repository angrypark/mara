{
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "agent_id": {
        "type": "string",
        "minLength": 1
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": [
          "completed",
          "running",
          "pending",
          "failed",
          "skipped",
          "blocked",
          "needs_input",
          "interrupted"
        ]
      },
      "depends_on": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "record_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "snapshot": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "status": {
                "enum": [
                  "completed",
                  "running",
                  "pending",
                  "needs_input",
                  "failed",
                  "skipped",
                  "blocked"
                ]
              },
              "summary": {
                "type": "string"
              },
              "inputs": {
                "type": "object"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16000
                    },
                    "kind": {
                      "enum": [
                        "text",
                        "list",
                        "weights",
                        "object"
                      ]
                    },
                    "value": {}
                  },
                  "required": [
                    "key",
                    "title",
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "text"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "list"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "weights"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "object"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": [
                              "object",
                              "array",
                              "boolean",
                              "number",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "records": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "maxItems": 120
              },
              "output": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "issues": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16000
                        },
                        "maxItems": 120
                      },
                      "unsupported_claims": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16000
                        },
                        "maxItems": 120
                      },
                      "qualitative_pass": {
                        "type": "boolean"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16000
                      },
                      "findings": {
                        "type": "array",
                        "maxItems": 25,
                        "items": {
                          "type": "object",
                          "properties": {
                            "category": {
                              "type": "string",
                              "enum": [
                                "personal_context",
                                "constraint",
                                "market_evidence",
                                "capability",
                                "execution",
                                "uncertainty"
                              ]
                            },
                            "blocks_proposal": {
                              "type": "boolean"
                            },
                            "subject": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 300
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1500
                            },
                            "resolution": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1500
                            },
                            "owner": {
                              "type": "string",
                              "enum": [
                                "user",
                                "context",
                                "evidence",
                                "buffett",
                                "marks",
                                "bogle",
                                "validation",
                                "leader",
                                "developer"
                              ]
                            }
                          },
                          "required": [
                            "category",
                            "blocks_proposal",
                            "subject",
                            "reason",
                            "resolution",
                            "owner"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "change_response": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "status",
                          "reason"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "accepted",
                              "partial",
                              "rejected"
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4000
                          }
                        }
                      }
                    },
                    "required": [
                      "issues",
                      "unsupported_claims",
                      "qualitative_pass",
                      "reason"
                    ],
                    "additionalProperties": false,
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "urn:mara:agent-validation:1.0.0"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_output_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stage": {
                "enum": [
                  "perspective_validation",
                  "final_validation"
                ]
              }
            },
            "required": [
              "label",
              "status",
              "summary",
              "inputs",
              "blocks",
              "records",
              "source_ids",
              "output",
              "source_output_id",
              "stage"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "id",
      "agent_id",
      "label",
      "status",
      "depends_on",
      "record_ids"
    ],
    "additionalProperties": false
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mara:flow:1.0.0",
  "$defs": {
    "household": {
      "type": "object",
      "properties": {
        "property_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "mortgage_balance": {
          "type": [
            "number",
            "null"
          ]
        },
        "property_equity": {
          "type": [
            "number",
            "null"
          ]
        },
        "loan_to_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "outside_emergency_cash": {
          "type": [
            "number",
            "null"
          ]
        },
        "monthly_debt_payment": {
          "type": [
            "number",
            "null"
          ]
        },
        "monthly_surplus_before_investing": {
          "type": [
            "number",
            "null"
          ]
        },
        "monthly_contribution": {
          "type": [
            "number",
            "null"
          ]
        },
        "monthly_remaining_after_investing": {
          "type": [
            "number",
            "null"
          ]
        },
        "debt_payment_in_expenses": {
          "type": "string"
        },
        "cashflow_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "limits": {
          "type": "string"
        },
        "base_currency": {
          "type": "string"
        }
      },
      "required": [
        "property_value",
        "mortgage_balance",
        "property_equity",
        "loan_to_value",
        "outside_emergency_cash",
        "monthly_debt_payment",
        "monthly_surplus_before_investing",
        "monthly_contribution",
        "monthly_remaining_after_investing",
        "debt_payment_in_expenses",
        "cashflow_complete",
        "limits"
      ],
      "additionalProperties": false
    },
    "contribution": {
      "type": "object",
      "properties": {
        "monthly_amount": {
          "type": "number"
        },
        "schedule": {
          "type": "string"
        },
        "amount_per_payment": {
          "type": "number"
        },
        "method": {
          "type": "string"
        }
      },
      "required": [
        "monthly_amount",
        "schedule",
        "amount_per_payment",
        "method"
      ],
      "additionalProperties": false
    },
    "evidence-assessment": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "proposal-evidence-1.0"
        },
        "selected_assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "string"
              }
            },
            "required": [
              "missing",
              "evidence_ids",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "blocks": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              }
            },
            "required": [
              "subject",
              "owner",
              "category",
              "blocks",
              "reason",
              "resolution"
            ],
            "additionalProperties": false
          }
        },
        "execution_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "selected_assets",
        "blockers",
        "execution_checks",
        "limits"
      ],
      "additionalProperties": false
    },
    "decision-status": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "portfolio_proposal_only"
        },
        "status": {
          "enum": [
            "blocked",
            "ready_for_user_review"
          ]
        },
        "numeric_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analyst_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "personal_context",
                  "constraint",
                  "market_evidence",
                  "capability",
                  "execution",
                  "uncertainty"
                ]
              },
              "blocks_proposal": {
                "type": "boolean"
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1500
              },
              "resolution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1500
              },
              "owner": {
                "type": "string",
                "enum": [
                  "user",
                  "context",
                  "evidence",
                  "buffett",
                  "marks",
                  "bogle",
                  "validation",
                  "leader",
                  "developer"
                ]
              }
            },
            "required": [
              "category",
              "blocks_proposal",
              "subject",
              "reason",
              "resolution",
              "owner"
            ],
            "additionalProperties": false
          }
        },
        "execution_status": {
          "const": "not_authorized"
        },
        "funding_availability": {
          "enum": [
            "conditional_on_deposit",
            "reported_holdings"
          ]
        },
        "execution_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "scope",
        "status",
        "numeric_blockers",
        "analyst_blockers",
        "findings",
        "execution_status",
        "funding_availability",
        "execution_checks"
      ],
      "additionalProperties": false
    },
    "monthly-plan": {
      "type": "object",
      "properties": {
        "schedule": {
          "enum": [
            "monthly",
            "days"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "amounts": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "status": {
          "enum": [
            "blocked",
            "conditional_plan"
          ]
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "schedule",
        "amount",
        "currency",
        "amounts",
        "status",
        "rule"
      ],
      "additionalProperties": false
    }
  }
}
