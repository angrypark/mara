                  "properties": {
                    "annualized_return": {
                      "type": "number"
                    },
                    "annualized_volatility": {
                      "type": "number"
                    },
                    "month_end_max_drawdown": {
                      "type": "number"
                    },
                    "ending_wealth": {
                      "type": "number"
                    },
                    "contributed": {
                      "type": "number"
                    },
                    "profit": {
                      "type": "number"
                    },
                    "transaction_cost_paid": {
                      "type": "number"
                    }
