{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mara.analysis/1.0.0"
    },
    "as_of": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    },
    "selected_weights": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "household": {
      "type": "object",
      "properties": {
