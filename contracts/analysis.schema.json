          "available": {
            "const": true
          }
        },
        "required": [
          "available"
        ]
      },
      "then": {
        "required": [
          "start",
          "end",
          "observations",
          "currency",
          "frequency",
          "results",
          "assumptions",
          "amount_unit",
          "cash_proxy_warning",
          "feasibility",
          "sensitivity",
          "limitations"
