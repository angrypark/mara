            "required": [
              "symbol",
              "kind",
              "whole_fraction",
              "invested_fraction",
              "proposal_amount",
              "monthly_amount"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "cash",
                  "investment"
                ]
              },
              "whole_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.000001
              },
              "invested_fraction": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1.000001
              },
              "proposal_amount": {
                "type": "number",
                "minimum": 0
              },
              "monthly_amount": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "usd_buffer_reference_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reference_authority": {
          "type": "string"
        },
        "unknown_asset_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cash_warning": {
          "type": "string"
