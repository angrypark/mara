                "properties": {
                  "income_fraction_assumption": {
                    "type": "number"
                  },
                  "mortgage_rate_increase_assumption": {
                    "type": "number"
                  },
                  "cash_needed_if_contributions_paused": {
                    "type": "number"
                  },
                  "gap_against_reported_account_cash_only": {
                    "type": "number"
                  },
                  "income_needed_to_resume_planned_contribution": {
                    "type": "number"
                  }
