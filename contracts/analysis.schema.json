      "properties": {
        "version": {
          "const": "allocation-sleeves/1"
        },
        "status": {
          "enum": [
            "decision_pending",
            "selected"
          ]
        },
        "scope": {
          "type": "string"
        },
        "capital": {
          "type": "number",
          "minimum": 0
        },
        "monthly_contribution": {
          "type": "number",
          "minimum": 0
        },
